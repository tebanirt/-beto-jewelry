# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# Higgsfield API credential, in "key-id:key-secret" format.
# Get one at https://higgsfield.ai (Model APIs / developer account).
HF_CREDENTIALS=

# Resend (transactional emails — lead forms, invoices)
RESEND_API_KEY=
CONTACT_EMAIL=betojewlz@gmail.com

# CRM (Supabase) — see supabase/schema.sql for the table setup.
# From your Supabase project: Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — restricted key (rk_test_… then rk_live_…) with write access to
# Payment Links + Prices/Products, read access to Checkout Sessions.
# On Vercel, mark both as "Sensitive". Never commit real values.
STRIPE_SECRET_KEY=
# From the webhook endpoint (…/api/stripe/webhook) in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Google Analytics 4 — optional override of the Measurement ID (default G-VG3PL11RYQ in code). Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=

# Admin dashboard (/admin) — pick your own values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
